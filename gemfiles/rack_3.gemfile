# frozen_string_literal: true

source 'https://rubygems.org'

gemspec path: '..'

group :development, :test do
  gem 'json_schemer', '~> 2.4'
  gem 'rack', '~> 3.0'
  gem 'rack-test', '~> 2.1'
  gem 'rake', '~> 13.2'
  gem 'rspec', '~> 3.13'
  gem 'rubocop', '~> 1.76', require: false
  gem 'simplecov', '~> 0.22', require: false
  gem 'webmock', '~> 3.25'
end
